NETWORLD_SNAPSHOT,
    type 9, sent by the server.

    packet looks like,
        [\x09\x00\x00\x00[payload]\x00]

    payload,
        [
            timestamp           :u32 (server world time in milliseconds),
            object_update_count :u8,
            object_updates      :[object_update, ...] (object_update_count entries, max 100),
            player_count        :u8,
            players             :[player_snapshot, ...] (player_count entries, max 100),
        ]

    object_update (8 bytes), same layout as NETWORLD_DELTA object_updates,
        [
            net_id          :u8,
            state           :u8,
            x               :u16,
            y               :u16,
            effect_id       :u8,
            progress        :u8 (0..255 -> 0.0..1.0),
        ]

    player_snapshot (24 bytes),
        [
            net_id          :u8,
            unknown_1       :u8 (always 0xFF),
            unknown_2       :u8 (always 0x03),
            action_cooldown :u8 (0..255 -> 0.0..1.0 seconds),
            player_frame    :u32 (frame counter from NETWORLD_STATE),
            flags           :u32 (TankFlags),
            unknown_u16     :u16 (always 0),
            x               :u16,
            y               :u16,
            velocity_x      :i16,
            velocity_y      :i16,
            jump_hold_time  :u8 (0..255 -> 0.0..1.0 seconds),
            jump_count      :u8 (0 = grounded, 1 = jump, 2 = double jump),
        ]

    sample,
        payload:
            fe494801000174ff0300cc00000010000000000058054f06000000000801

        decoded:
            timestamp        = 21514750
            object_update_count = 0
            player_count     = 1
            players[0]       = PlayerSnapshot(
                net_id         = 116,
                unknown_1      = 255,
                unknown_2      = 3,
                action_cooldown = 0,
                player_frame   = 204,
